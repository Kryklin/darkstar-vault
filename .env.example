# GitHub Personal Access Token (for Electron Forge release publishing)
GITHUB_TOKEN=your_github_token_here

# Optional: Path to D-ARX Native Crypto Engine executable (from kryklin/darkstar)
# DARKSTAR_ENGINE_PATH=./bin/d-arx.exe

# Build Integrity Signing Private Key (Ed25519 PKCS#8 PEM)
# Required for signing release integrity.json manifests. NEVER commit the actual private key.
# - Local Development & Manual Packaging: Set this key in your local gitignored .env file.
# - Automated CI/CD & Production Releases: Injected via secure CI secrets or hardware security module (HSM) signing services.
# DARKSTAR_BUILD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
