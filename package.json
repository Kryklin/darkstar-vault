    "@capacitor/core": "^7.0.1",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.0.1",
    "@noble/post-quantum": "^0.2.0",
    "@scure/base": "^1.1.9",
    "electron-squirrel-startup": "^1.0.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^2.5.2",
    "material-icons": "^1.13.14",
    "ngx-markdown": "^21.3.0",
    "node-machine-id": "^1.1.12",
    "otplib": "^12.0.1",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
