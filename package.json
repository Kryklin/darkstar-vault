    "electron": "^34.2.0",
    "eslint": "^9.20.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "execa": "^9.6.1",
    "inquirer": "^9.3.8",
    "jasmine-core": "~5.6.0",
    "javascript-obfuscator": "^4.1.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.9",
    "ora": "^9.0.0",
    "prettier": "^3.5.1",
    "tsx": "^4.22.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.24.0",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "@angular-devkit/core": {
      "ajv": "^8.18.0"
    },
