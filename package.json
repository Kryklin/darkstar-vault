{
  "name": "darkstar-vault",
  "version": "3.0.6",
  "productName": "Darkstar Vault",
  "description": "Darkstar Vault - Sovereign Post-Quantum Enclave",
  "author": "Darkstar Security",
  "homepage": "https://github.com/Kryklin/darkstar-vault",
  "license": "CC-BY-4.0",
  "private": true,
  "main": "dist/electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kryklin/darkstar-vault.git"
  },
  "scripts": {
    "start": "npx tsx scripts/package.ts",
    "dev": "concurrently -k --success first \"ng serve\" \"wait-on http://localhost:4200 && npx tsx scripts/dev-wrapper.ts\"",
    "build": "ng build --configuration production --base-href ./ && tsc --p tsconfig.electron.json && npx javascript-obfuscator dist/electron --output dist/electron && npx tsx scripts/build-integrity.ts",
    "build:angular": "ng build --configuration production --base-href ./",
    "build:electron": "tsc --p tsconfig.electron.json && npx tsx scripts/build-integrity.ts",
    "lint": "npx tsx scripts/lint.ts",
    "lint:ts": "ng lint",
    "format": "npx tsx scripts/format.ts",
    "test": "ng test --watch=false --browsers=ChromeHeadless && npx tsx scripts/test-webauthn.ts && npx tsx scripts/test-engine-trust.ts && npx tsx scripts/test-ipc-filesystem.ts",
    "test:webauthn": "npx tsx scripts/test-webauthn.ts",
    "test:engine": "npx tsx scripts/test-engine-trust.ts",
    "test:security": "npx tsx scripts/test-webauthn.ts && npx tsx scripts/test-engine-trust.ts && npx tsx scripts/test-ipc-filesystem.ts",
    "clean": "npx tsx scripts/clean.ts",
    "checksums": "npx tsx scripts/checksums.ts",
    "audit": "npx tsx scripts/audit.ts",
    "fetch:engines": "npx tsx scripts/fetch-engines.ts",
    "rename:arx": "npx tsx scripts/replace-legacy-crypto-names.ts",
    "generate:icons": "npx tsx scripts/generate-icons.ts",
    "splash": "npx tsx scripts/splash-maker.ts",
    "package": "electron-forge package",
    "publish": "electron-forge publish"
  },
  "prettier": {
    "printWidth": 200,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.1",
    "@angular/compiler": "^21.1.1",
    "@angular/core": "^21.1.1",
    "@angular/forms": "^21.1.1",
    "@angular/material": "^21.1.1",
